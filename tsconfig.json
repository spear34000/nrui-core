{
  "compilerOptions": {
    "target": "ES2019",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "rootDir": "./",
    "outDir": "dist",
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true
  },
  "include": ["core/**/*", "renderer/**/*", "examples/**/*", "tests/**/*", "types/**/*", "MODEL.md", "README.md"],
  "exclude": ["dist", "node_modules"]
}
